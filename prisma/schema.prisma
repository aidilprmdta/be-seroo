generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN_PUSAT
  OWNER_MITRA
  OWNER
  MANAGER
  CREW
}

enum OrderStatus {
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
  SPLIT
}

enum PaymentStatus {
  RECORDED
  PENDING_RECONCILIATION
  BELUM_LUNAS
  LUNAS
  REFUNDED
}

enum ShiftHandoverStatus {
  PENDING
  ACCEPTED
  REJECTED
  CONFIRMED
}

enum ShopeeFoodStatus {
  PENDING
  PICKED
  DELIVERED
  SETTLED
  CANCELLED
}

enum StockTransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum StockMovementType {
  IN
  OUT
  WASTE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  LOSS
}

enum LossReportStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum StockRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ExpenseStatus {
  ACTIVE
  CANCELLED
}

enum ExpenseAuditAction {
  CORRECTED
  CANCELLED
}

enum ClosingType {
  DAILY
  MONTHLY
}

enum ClosingStatus {
  CLOSED
  REOPENED
}

enum ClosingAuditAction {
  CLOSED
  REOPENED
  RECLOSED
}

enum UserPasswordActivity {
  ADMIN_RESET
  SELF_CHANGE
}

// ==========================================
// USERS & OUTLETS
// ==========================================

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships                        OutletMembership[]
  authSessions                       AuthSession[]
  passwordAuditsAsActor              UserPasswordAudit[]         @relation("UserPasswordAuditActor")
  passwordAuditsAsTarget             UserPasswordAudit[]         @relation("UserPasswordAuditTarget")
  orders                             Order[]
  verifiedOrders                     Order[]                     @relation("OrderVerifiedBy")
  verifiedPayments                   OrderPayment[]              @relation("OrderPaymentVerifiedBy")
  expenses                           Expense[]
  expenseAudits                      ExpenseAudit[]              @relation("ExpenseAuditActor")
  wasteRecords                       WasteRecord[]
  stockMovements                     StockMovement[]
  requestedStockOrders               StockRequest[]              @relation("RequestedBy")
  processedStockOrders               StockRequest[]              @relation("ProcessedBy")
  requestedOutletStockRequests       OutletStockRequest[]        @relation("OutletStockRequestCreatedBy")
  processedOutletStockRequests       OutletStockRequest[]        @relation("OutletStockRequestProcessedBy")
  closingsClosed                     ClosingRecord[]             @relation("ClosingClosedBy")
  closingsReopened                   ClosingRecord[]             @relation("ClosingReopenedBy")
  closingHistories                   ClosingHistory[]            @relation("ClosingHistoryClosedBy")
  closingAudits                      ClosingAudit[]              @relation("ClosingAuditActor")
  cashOpenings                       CashOpening[]               @relation("CashOpeningOpenedBy")
  cancelledOrders                    Order[]                     @relation("OrderCancelledBy")
  orderStatusHistories               OrderStatusHistory[]        @relation("OrderStatusHistoryActor")
  auditLogs                          AuditLog[]                  @relation("AuditLogActor")
  outletProductAvailabilitiesUpdated OutletProductAvailability[] @relation("OutletProductAvailabilityUpdatedBy")
  reportedLosses                     LossReport[]                @relation("LossReportReportedBy")
  reviewedLosses                     LossReport[]                @relation("LossReportReviewedBy")
  shiftHandovers                     ShiftHandover[]               @relation(name: "ShiftHandoverCrew")
  outletStockTransfersRequested      OutletStockTransfer[]         @relation(name: "OutletStockTransferRequested")
  outletStockTransfersApproved       OutletStockTransfer[]         @relation(name: "OutletStockTransferApproved")
}

model UserPasswordAudit {
  id           String               @id @default(cuid())
  actorUserId  String
  targetUserId String
  activity     UserPasswordActivity
  createdAt    DateTime             @default(now())

  actor  User @relation("UserPasswordAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target User @relation("UserPasswordAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model AuditLog {
  id           String       @id @default(cuid())
  actorUserId  String?
  sessionId    String?
  outletId     String?
  action       String
  resourceType String
  resourceId   String?
  outcome      AuditOutcome @default(SUCCESS)
  metadata     Json?
  createdAt    DateTime     @default(now())

  actor   User?        @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  session AuthSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  outlet  Outlet?      @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([outletId, createdAt])
  @@index([resourceType, action, createdAt])
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  deviceName String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([userId, revokedAt])
  @@index([userId, revokedAt, lastSeenAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String
  tokenHash String    @unique
  issuedAt  DateTime  @default(now())
  usedAt    DateTime?
  revokedAt DateTime?

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, usedAt])
}

model Outlet {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         OutletMembership[]
  orders              Order[]
  expenses            Expense[]
  expenseAudits       ExpenseAudit[]
  stocks              OutletStock[]
  stockMovements      StockMovement[]
  wasteRecords        WasteRecord[]
  outletStockRequests OutletStockRequest[]
  closings            ClosingRecord[]
  closingAudits       ClosingAudit[]
  cashOpenings        CashOpening[]
  auditLogs           AuditLog[]

  productAvailabilities OutletProductAvailability[]
  lossReports           LossReport[]

  shopeeFoodOrders        ShopeeFoodOrder[]             @relation(name: "ShopeeFoodOrder_Outlet")
  outletStockTransfers    OutletStockTransfer[]         @relation(name: "OutletStockTransferFrom")
  incomingTransfer        OutletStockTransfer[]         @relation(name: "OutletStockTransferTo")
  stockTransfers          OutletStockTransfer[]         @relation(name: "OutletStockTransfer_Outlet")
  shiftHandovers          ShiftHandover[]               @relation(name: "ShiftHandover_Outlet")

  outgoingRequests StockRequest[] @relation("SourceOutlet")
  incomingRequests StockRequest[] @relation("DestinationOutlet")
}

model OutletMembership {
  id        String   @id @default(cuid())
  userId    String
  outletId  String
  role      Role
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@index([outletId, role])
}

// ==========================================
// PRODUCTS & POS
// ==========================================

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants             ProductVariant[]
  outletAvailabilities OutletProductAvailability[]
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String
  price     Decimal @db.Decimal(12, 2)
  isActive  Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@unique([productId, name])
}

model AddOn {
  id        String   @id @default(cuid())
  name      String
  price     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orderItems OrderItemAddOn[]
}

model Order {
  id                  String        @id @default(cuid())
  outletId            String
  crewId              String
  orderNumber         String
  status              OrderStatus   @default(COMPLETED)
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus @default(RECORDED)
  clientTransactionId String?
  payloadHash         String?
  subtotal            Decimal       @db.Decimal(12, 2)
  total               Decimal       @db.Decimal(12, 2)
  notes               String?
  verifiedAt          DateTime?
  verifiedById        String?
  cancelledAt         DateTime?
  cancelledById       String?
  cancellationReason  String?
  isWasteRecorded     Boolean       @default(false)
  createdAt           DateTime      @default(now())
  completedAt         DateTime?

  outlet        Outlet               @relation(fields: [outletId], references: [id])
  crew          User                 @relation(fields: [crewId], references: [id])
  verifiedBy    User?                @relation("OrderVerifiedBy", fields: [verifiedById], references: [id])
  cancelledBy   User?                @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  items         OrderItem[]
  payments      OrderPayment[]
  statusHistory OrderStatusHistory[]

  shopeeFoodOrders ShopeeFoodOrder[] @relation(name: "ShopeeFoodOrder")
}

model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus
  toStatus   OrderStatus
  reason     String?
  actorId    String
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User  @relation("OrderStatusHistoryActor", fields: [actorId], references: [id])

  @@index([orderId, createdAt])
}

model OrderPayment {
  id            String        @id @default(cuid())
  orderId       String
  paymentMethod PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(LUNAS)
  notes         String?
  verifiedAt    DateTime?
  verifiedById  String?
  createdAt     DateTime      @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("OrderPaymentVerifiedBy", fields: [verifiedById], references: [id])

  @@index([orderId])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productVariantId String
  productName      String
  variantName      String
  quantity         Int
  unitPrice        Decimal @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(12, 2)

  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant   @relation(fields: [productVariantId], references: [id])
  addOns         OrderItemAddOn[]
}

model OrderItemAddOn {
  id          String  @id @default(cuid())
  orderItemId String
  addOnId     String?
  addOnName   String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addOn     AddOn?    @relation(fields: [addOnId], references: [id], onDelete: SetNull)
}

// ==========================================
// EXPENSES & FINANCE
// ==========================================

model ExpenseCategory {
  id            String   @id @default(cuid())
  name          String   @unique
  isProvisional Boolean  @default(true)
  createdAt     DateTime @default(now())

  expenses Expense[]
}

model Expense {
  id                  String        @id @default(cuid())
  outletId            String
  categoryId          String
  createdById         String
  clientTransactionId String?
  payloadHash         String?
  description         String?
  amount              Decimal       @db.Decimal(12, 2)
  expenseDate         DateTime
  status              ExpenseStatus @default(ACTIVE)
  cancelledAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  outlet    Outlet          @relation(fields: [outletId], references: [id])
  category  ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  audits    ExpenseAudit[]

  @@unique([outletId, createdById, clientTransactionId])
  @@index([outletId, expenseDate])
}

model ExpenseAudit {
  id                  String             @id @default(cuid())
  expenseId           String
  outletId            String
  actorId             String
  clientTransactionId String
  payloadHash         String
  action              ExpenseAuditAction
  reason              String?
  beforeSnapshot      Json
  afterSnapshot       Json
  createdAt           DateTime           @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  outlet  Outlet  @relation(fields: [outletId], references: [id], onDelete: Restrict)
  actor   User    @relation("ExpenseAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([outletId, actorId, clientTransactionId])
  @@index([outletId, expenseId, createdAt])
}

// ==========================================
// INVENTORY & STOCK
// ==========================================

model InventoryItem {
  id        String   @id @default(cuid())
  name      String
  unit      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stocks             OutletStock[]
  movements          StockMovement[]
  requestItems       StockRequestItem[]
  outletRequestItems OutletStockRequestItem[]
  wasteRecords       WasteRecord[]
  lossReports        LossReport[]
}

model OutletStock {
  id              String   @id @default(cuid())
  outletId        String
  inventoryItemId String
  quantity        Decimal  @default(0) @db.Decimal(12, 3)
  minimumQuantity Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt       DateTime @updatedAt

  outlet        Outlet        @relation(fields: [outletId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([outletId, inventoryItemId])
}

model StockMovement {
  id                  String            @id @default(cuid())
  outletId            String
  inventoryItemId     String
  createdById         String
  clientTransactionId String?
  payloadHash         String?
  type                StockMovementType
  quantity            Decimal           @db.Decimal(12, 3)
  note                String?
  referenceCode       String?
  lossReportId        String?           @unique
  expectedQuantity    Decimal?          @db.Decimal(12, 3)
  quantityBefore      Decimal?          @db.Decimal(12, 3)
  quantityAfter       Decimal?          @db.Decimal(12, 3)
  createdAt           DateTime          @default(now())

  outlet        Outlet        @relation(fields: [outletId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])
  lossReport    LossReport?   @relation(fields: [lossReportId], references: [id], onDelete: Restrict)

  @@unique([outletId, createdById, clientTransactionId])
  @@index([outletId, inventoryItemId, createdAt])
}

model OutletProductAvailability {
  id          String   @id @default(cuid())
  outletId    String
  productId   String
  isAvailable Boolean  @default(true)
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet    Outlet  @relation(fields: [outletId], references: [id], onDelete: Restrict)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  updatedBy User    @relation("OutletProductAvailabilityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([outletId, productId])
  @@index([outletId, isAvailable])
}

model LossReport {
  id              String           @id @default(cuid())
  outletId        String
  reportedById    String
  inventoryItemId String
  itemName        String
  quantity        Decimal          @db.Decimal(12, 3)
  unit            String
  reason          String
  description     String?
  status          LossReportStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  outlet        Outlet         @relation(fields: [outletId], references: [id], onDelete: Restrict)
  reportedBy    User           @relation("LossReportReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  reviewedBy    User?          @relation("LossReportReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  stockMovement StockMovement?

  @@index([outletId, status, createdAt])
  @@index([outletId, inventoryItemId, createdAt])
}

model StockRequest {
  id                  String             @id @default(cuid())
  sourceOutletId      String
  destinationOutletId String
  requestedById       String
  processedById       String?
  status              StockRequestStatus @default(PENDING)
  note                String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  sourceOutlet      Outlet @relation("SourceOutlet", fields: [sourceOutletId], references: [id])
  destinationOutlet Outlet @relation("DestinationOutlet", fields: [destinationOutletId], references: [id])

  requestedBy User  @relation("RequestedBy", fields: [requestedById], references: [id])
  processedBy User? @relation("ProcessedBy", fields: [processedById], references: [id])

  items StockRequestItem[]
}

model StockRequestItem {
  id              String   @id @default(cuid())
  stockRequestId  String
  inventoryItemId String
  requestedQty    Decimal  @db.Decimal(12, 3)
  approvedQty     Decimal? @db.Decimal(12, 3)

  stockRequest  StockRequest  @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([stockRequestId, inventoryItemId])
}

model OutletStockRequest {
  id                  String             @id @default(cuid())
  outletId            String
  requestedById       String
  processedById       String?
  clientTransactionId String
  payloadHash         String
  status              StockRequestStatus @default(PENDING)
  note                String?
  decisionNote        String?
  processedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  outlet      Outlet                   @relation(fields: [outletId], references: [id], onDelete: Restrict)
  requestedBy User                     @relation("OutletStockRequestCreatedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  processedBy User?                    @relation("OutletStockRequestProcessedBy", fields: [processedById], references: [id], onDelete: Restrict)
  items       OutletStockRequestItem[]

  @@unique([outletId, requestedById, clientTransactionId])
  @@index([outletId, status, createdAt])
}

model OutletStockRequestItem {
  id              String  @id @default(cuid())
  requestId       String
  inventoryItemId String
  itemName        String
  unit            String
  quantity        Decimal @db.Decimal(12, 3)

  request       OutletStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([requestId, inventoryItemId])
}

// ==========================================
// WASTE
// ==========================================

model WasteRecord {
  id                  String   @id @default(cuid())
  outletId            String
  createdById         String
  clientTransactionId String?
  payloadHash         String?
  inventoryItemId     String?
  itemName            String
  category            String
  quantity            Decimal  @db.Decimal(12, 3)
  unit                String
  description         String?
  wasteDate           DateTime
  createdAt           DateTime @default(now())

  outlet        Outlet         @relation(fields: [outletId], references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@unique([outletId, createdById, clientTransactionId])
  @@index([outletId, wasteDate])
}

// ==========================================
// CLOSING & REOPEN
// ==========================================

model CashOpening {
  id          String   @id @default(cuid())
  outletId    String
  periodKey   String
  openingCash Decimal  @db.Decimal(12, 2)
  openedById  String
  openedAt    DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Restrict)
  openedBy User   @relation("CashOpeningOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)

  @@unique([outletId, periodKey])
  @@index([outletId, periodKey])
}

model ClosingRecord {
  id                  String        @id @default(cuid())
  outletId            String
  closingType         ClosingType
  periodKey           String
  status              ClosingStatus @default(CLOSED)
  closedById          String
  closedAt            DateTime      @default(now())
  reopenedById        String?
  reopenedAt          DateTime?
  reopenReason        String?
  version             Int           @default(1)
  summarySnapshot     Json
  notes               String?
  unfinishedCount     Int           @default(0)
  openingCash         Decimal?      @db.Decimal(12, 2)
  cashSales           Decimal?      @db.Decimal(12, 2)
  cashExpenses        Decimal?      @db.Decimal(12, 2)
  expectedCash        Decimal?      @db.Decimal(12, 2)
  actualCash          Decimal?      @db.Decimal(12, 2)
  cashDifference      Decimal?      @db.Decimal(12, 2)
  differenceReason    String?
  clientTransactionId String?
  payloadHash         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  outlet     Outlet           @relation(fields: [outletId], references: [id], onDelete: Restrict)
  closedBy   User             @relation("ClosingClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  reopenedBy User?            @relation("ClosingReopenedBy", fields: [reopenedById], references: [id], onDelete: Restrict)
  history    ClosingHistory[]
  audits     ClosingAudit[]

  @@unique([outletId, closingType, periodKey])
  @@unique([outletId, closedById, clientTransactionId])
  @@index([outletId, closingType, periodKey])
}

model ClosingHistory {
  id              String    @id @default(cuid())
  closingId       String
  version         Int
  closedById      String
  closedAt        DateTime
  summarySnapshot Json
  notes           String?
  unfinishedCount Int       @default(0)
  reopenedById    String?
  reopenedAt      DateTime?
  reopenReason    String?
  createdAt       DateTime  @default(now())

  closing  ClosingRecord @relation(fields: [closingId], references: [id], onDelete: Cascade)
  closedBy User          @relation("ClosingHistoryClosedBy", fields: [closedById], references: [id], onDelete: Restrict)

  @@index([closingId, version])
}

model ClosingAudit {
  id                  String             @id @default(cuid())
  closingId           String
  outletId            String
  actorId             String
  clientTransactionId String
  payloadHash         String
  action              ClosingAuditAction
  reason              String?
  version             Int
  beforeSnapshot      Json?
  afterSnapshot       Json?
  createdAt           DateTime           @default(now())

  closing ClosingRecord @relation(fields: [closingId], references: [id], onDelete: Restrict)
  outlet  Outlet        @relation(fields: [outletId], references: [id], onDelete: Restrict)
  actor   User          @relation("ClosingAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([outletId, actorId, clientTransactionId])
  @@index([outletId, closingId, createdAt])
}

model ShiftHandover {
  id            String   @id @default(cuid())
  outletId      String
  crewId        String?
  crewName      String?
  crewUserId    String?
  nextOutlet    String
  handoverAt    DateTime @default(now())
  status        ShiftHandoverStatus @default(PENDING)
  notes         String?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  rejectedReason String?
  acceptedByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outlet   Outlet  @relation(fields: [outletId], references: [id], onDelete: Restrict, name: "ShiftHandover_Outlet")
  crew     User?   @relation(name: "ShiftHandoverCrew", fields: [crewUserId], references: [id], onDelete: Restrict)

  @@index([outletId, status])
  @@index([nextOutlet, status])
}

model ShopeeFoodOrder {
  id                 String       @id @default(cuid())
  outletId           String
  orderId            String?      @unique(map: "ShopeeFoodOrder_Order")
  platformOrderId    String
  platformStatus     ShopeeFoodStatus @default(PENDING)
  driverName         String?
  driverPhone        String?
  shipperName        String?
  shipperPhone       String?
  deliveryAddress    String?
  estimatedArrival   DateTime?
  totalAmount        Decimal      @db.Decimal(12, 2)
  items              String?
  paymentMethod      PaymentMethod @default(CASH)
  paymentStatus      PaymentStatus @default(RECORDED)
  notes              String?
  pickedAt           DateTime?
  deliveredAt        DateTime?
  settledAt          DateTime?
  cancelledAt        DateTime?
  cancelledReason    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Restrict, name: "ShopeeFoodOrder_Outlet")
  order  Order? @relation(name: "ShopeeFoodOrder", fields: [orderId], references: [id], onDelete: Cascade)

  @@index([outletId, platformStatus])
  @@index([outletId, createdAt])
}

model OutletStockTransfer {
  id                String         @id @default(cuid())
  outletId          String
  fromOutletId      String
  toOutletId        String
  requestedById     String
  requestedByName   String?
  approvedById      String?
  approvedByName    String?
  status            StockTransferStatus @default(PENDING)
  itemIds           String[]
  quantities        String[]
  totalQuantity     Int?
  notes             String?
  requestedAt       DateTime @default(now())
  approvedAt        DateTime?
  cancelledAt       DateTime?
  cancelledReason   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  outlet       Outlet @relation(fields: [outletId], references: [id], onDelete: Restrict, name: "OutletStockTransfer_Outlet")
  fromOutlet   Outlet @relation(name: "OutletStockTransferFrom", fields: [fromOutletId], references: [id], onDelete: Cascade, map: "OutletStockTransfer_FromOutlet")
  toOutlet     Outlet @relation(name: "OutletStockTransferTo", fields: [toOutletId], references: [id], onDelete: Restrict, map: "OutletStockTransfer_ToOutlet")
  requestedBy  User @relation(name: "OutletStockTransferRequested", fields: [requestedById], references: [id], onDelete: Restrict, map: "OutletStockTransfer_RequestedBy")
  approvedBy   User? @relation(name: "OutletStockTransferApproved", fields: [approvedById], references: [id], onDelete: Restrict, map: "OutletStockTransfer_ApprovedBy")

  @@index([outletId, status])
  @@index([fromOutletId, toOutletId, status])
}
