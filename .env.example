# Runtime mode Node.js (development, production, test)
NODE_ENV=development
# Lingkungan deployment (development, staging, production)
DEPLOYMENT_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/seroo_dev?schema=public
# Replace with a unique random value of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Comma-separated browser origins. Leave empty for native/mobile-only deployments.
CORS_ORIGINS=

# Staging Seed Security Guard (Strict Exact Target Pair Matching)
ALLOW_STAGING_SEED=false
# Pasangan exact target yang disetujui untuk seed staging (format: host:database)
# Default resmi: staging-db.seroo.id:seroo_staging, seroo-staging.internal:seroo_staging, staging.internal:seroo_staging
# STAGING_TARGET_PAIRS=staging-db.seroo.id:seroo_staging,seroo-staging.internal:seroo_staging

# Optional local-only developer account seed. Keep disabled by default.
SEROO_DEV_ACCOUNT_SEED_ENABLED=false
SEROO_DEV_ACCOUNT_EMAIL=
SEROO_DEV_ACCOUNT_NAME=
SEROO_DEV_ACCOUNT_PASSWORD=
SEROO_DEV_ACCOUNT_OUTLET_ID=
