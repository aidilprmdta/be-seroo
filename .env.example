NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/seroo_dev?schema=public
# Replace with a unique random value of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Comma-separated browser origins. Leave empty for native/mobile-only deployments.
CORS_ORIGINS=
# Optional local-only developer account seed. Keep disabled by default.
SEROO_DEV_ACCOUNT_SEED_ENABLED=false
SEROO_DEV_ACCOUNT_EMAIL=
SEROO_DEV_ACCOUNT_NAME=
SEROO_DEV_ACCOUNT_PASSWORD=
SEROO_DEV_ACCOUNT_OUTLET_ID=
